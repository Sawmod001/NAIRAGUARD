// NairaGuard Prisma Schema — NG-101 Real Prod (Auth.js)
// PostgreSQL via DATABASE_URL, Auth.js v5 + PrismaAdapter + DB sessions (httpOnly secure cookie)
// Verification dormant: EMAIL_FROM not set → no email sent, ready when domain verified

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Minimal health check — retains NG-004 foundation
model HealthCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  status    String   @default("ok")

  @@map("health_checks")
}

// --- Auth.js models (PrismaAdapter) ---
model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  // Credentials: stored as bcrypt hash, never plaintext (NG-101 prod)
  password      String?
  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// NG-AUTH-05: password reset tokens — hashed at rest, single-use, 1h expiry
model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expires])
  @@map("password_reset_tokens")
}

// NG-ORG-01 (merged forward): slug/type/country per 02-AUTH-ORG-DEMO.md
model Organization {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  type           String          @default("workspace")
  country        String          @default("NG")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  memberships    Membership[]
  activityEvents ActivityEvent[]
  awsConnections AwsConnection[]
  awsOrganizations AwsOrganization[]
  awsAccounts    AwsAccount[]

  @@map("organizations")
}

// NG-AWS-01: production AWS connection (cross-account IAM Role + STS).
// No secret fields by design — NairaGuard never stores long-lived customer keys.
// AWS Organization/Account discovery tables arrive in NG-AWS-06; the demo seeds
// a single Production Account without touching this model.
enum AwsConnectionStatus {
  NOT_CONNECTED
  PENDING
  VALIDATING
  CONNECTED
  SYNCING
  SYNCED
  STALE
  AUTH_FAILED
  PERMISSION_DENIED
  RATE_LIMITED
  ERROR
  DISCONNECTED
}

model AwsConnection {
  id              String              @id @default(cuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleArn         String?
  externalId      String              @unique
  status          AwsConnectionStatus @default(NOT_CONNECTED)
  lastValidatedAt DateTime?
  lastError       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("aws_connections")
}

// NG-AWS-06: AWS inventory registry — NairaGuard org → many AWS organizations
// → many AWS accounts. Never assume one workspace equals one AWS account.
// Rows are discovered (validation org-discovery, later sync), never hand-typed;
// accountId pairs are unique per workspace for tenant-safe scoping.
model AwsOrganization {
  id               String        @id @default(cuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  awsOrgId         String?
  managementAccountId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  accounts         AwsAccount[]

  @@index([organizationId])
  @@map("aws_organizations")
}

model AwsAccount {
  id                String           @id @default(cuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  awsOrganizationId String?
  awsOrganization   AwsOrganization? @relation(fields: [awsOrganizationId], references: [id], onDelete: SetNull)
  accountId         String
  name              String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([organizationId, accountId])
  @@index([organizationId])
  @@map("aws_accounts")
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           String       @default("OWNER")
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("memberships")
}

model ActivityEvent {
  id             String   @id @default(cuid())
  organizationId String
  type           String
  title          String
  description    String?
  resourceId     String?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("activity_events")
}
