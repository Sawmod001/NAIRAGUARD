# NairaGuard Environment — EXAMPLE (no secrets)
# Copy to .env.local and fill locally. Never commit .env* with real values.

# App mode: demo | aws (future)
APP_MODE=demo
AI_MODE=mock
FX_MODE=demo

# Database (required from NG-004 onward; placeholder for NG-001)
DATABASE_URL=postgresql://user:password@localhost:5432/nairaguard

# Auth — Auth.js (required from NG-101 onward) — server-only, no NEXT_PUBLIC_
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Email (Resend) — verification dormant until domain verified (set EMAIL_FROM to verified domain to enable)
RESEND_API_KEY=
EMAIL_FROM=

# AI provider (required only when AI_MODE=live)
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=

# FX provider (required only when FX_MODE=live)
FX_PROVIDER_API_KEY=
FX_PROVIDER_URL=

# AWS cross-account (NG-AWS-02): NairaGuard delivery account shown in the customer trust policy.
# Leave empty until the delivery account exists — UI renders a marked placeholder.
AWS_NAIRAGUARD_ACCOUNT_ID=

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000
